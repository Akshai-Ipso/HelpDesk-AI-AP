@HelpDesk.Api_HostAddress = https://localhost:7177

POST {{HelpDesk.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "benutzername": "support",
  "passwort": "Support123!"
}

###

# Den zurückgegebenen JWT-Token in Visual Studio als Umgebungsvariable
# jwtToken hinterlegen, bevor die folgende Anfrage ausgeführt wird.
GET {{HelpDesk.Api_HostAddress}}/api/tickets
Authorization: Bearer {{jwtToken}}
Accept: application/json
